# Copy to .env and fill in (hsctl setup generates this for you).

# This server's LAN IP — used as the cert SAN so https://<ip>:<port> is trusted
# (Caddy's local CA, installed once per device). No hostnames/TLD are used.
SERVER_IP=192.168.1.10

# Let's Encrypt account contact (only used with the optional public domain below).
ACME_EMAIL=you@example.com

# Where Caddy forwards each app. The apps live on the shared "edge" docker network, so these
# are container names — set as defaults in caddy/docker-compose.yml and intentionally NOT
# listed here (so no app is published as plaintext HTTP on the LAN). Override only if you
# rename a service. For reference the defaults are:
#   VAULT_UPSTREAM=vaultwarden:80   CLOUD_UPSTREAM=nextcloud-app:80   PIHOLE_UPSTREAM=pihole:80
#   STIRLING_UPSTREAM=stirling-pdf:8080   ITTOOLS_UPSTREAM=it-tools:80   IMAGETOOLS_UPSTREAM=imagetools:80
# The hsctl web UI runs on the HOST (not a container), so it's still reached via the docker
# host gateway. hsctl binds it to the gateway + loopback only, never the LAN.
HOME_UPSTREAM=host.docker.internal:8088

# HTTPS ports each app is exposed on (https://SERVER_IP:PORT). Must match services.json
# (the dashboard) so its tiles link to the right place.
VAULT_HTTPS=8443
CLOUD_HTTPS=8444
PIHOLE_HTTPS=8445
HOME_HTTPS=443
STIRLING_HTTPS=8446
ITTOOLS_HTTPS=8447
IMAGETOOLS_HTTPS=8448

# Optional public domain + Let's Encrypt — managed by `hsctl letsencrypt` / the dashboard.
# When LETSENCRYPT=true hsctl generates a complete config into generated/Caddyfile — https://<app>.DOMAIN
# for every app on :443 (so HOME_HTTPS must stay 443), publicly trusted certificates, no private CA /
# IP:port sites — and sets CADDY_CONFIG so Caddy loads it instead of ./Caddyfile. Nothing here is
# required for the default private-CA setup.
DOMAIN=
LETSENCRYPT=false
# dns = Caddy proves ownership via your DNS provider's API (nothing port-forwarded; LAN-only).
# http = Let's Encrypt connects to port 80 here from the internet (needs port-forwarding).
ACME_CHALLENGE=dns
# caddy-dns plugin for the dns challenge (cloudflare, duckdns, hetzner, …) and its API token.
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_TOKEN=
# Let's Encrypt's staging CA: untrusted test certificates, no rate limits — for trying it out.
ACME_STAGING=false
# Set by hsctl in Let's Encrypt mode: which config `caddy run` loads (unset = ./Caddyfile, private CA)
# and, for the dns challenge, the local caddy+plugin build (see Dockerfile; unset = stock image).
#CADDY_CONFIG=/etc/caddy/generated/Caddyfile
#CADDY_IMAGE=homeserver-caddy:cloudflare
