# Your own domain's sites — the same apps as the Caddyfile, on the same ports, but at
# https://<your domain>:<port> with a Let's Encrypt certificate instead of the private CA,
# so devices trust them without installing root.crt.
#
# Don't import this by hand: `hsctl cert` writes domain.caddy (`import letsencrypt.caddy
# <domain>`) once the certificate exists, so {args[0]} below is your domain. The certificate
# is <repo>/letsencrypt/certificates/<domain>.crt/.key, mounted read-only at /letsencrypt;
# hsctl renews it and reloads Caddy. See docs/letsencrypt.md.
#
# Adding an app? Give it a block here too, mirroring its {$SERVER_IP} block in the Caddyfile.

{args[0]}:{$VAULT_HTTPS} {
	bind 0.0.0.0
	tls /letsencrypt/certificates/{args[0]}.crt /letsencrypt/certificates/{args[0]}.key
	import vault
}

{args[0]}:{$CLOUD_HTTPS} {
	bind 0.0.0.0
	tls /letsencrypt/certificates/{args[0]}.crt /letsencrypt/certificates/{args[0]}.key
	import cloud
}

{args[0]}:{$PIHOLE_HTTPS} {
	bind 0.0.0.0
	tls /letsencrypt/certificates/{args[0]}.crt /letsencrypt/certificates/{args[0]}.key
	import pihole
}

{args[0]}:{$HOME_HTTPS} {
	bind 0.0.0.0
	tls /letsencrypt/certificates/{args[0]}.crt /letsencrypt/certificates/{args[0]}.key
	import home
}

{args[0]}:{$STIRLING_HTTPS} {
	bind 0.0.0.0
	tls /letsencrypt/certificates/{args[0]}.crt /letsencrypt/certificates/{args[0]}.key
	import stirling
}

{args[0]}:{$ITTOOLS_HTTPS} {
	bind 0.0.0.0
	tls /letsencrypt/certificates/{args[0]}.crt /letsencrypt/certificates/{args[0]}.key
	import ittools
}

{args[0]}:{$IMAGETOOLS_HTTPS} {
	bind 0.0.0.0
	tls /letsencrypt/certificates/{args[0]}.crt /letsencrypt/certificates/{args[0]}.key
	import imagetools
}
