# REFERENCE ONLY — don't copy this by hand. `hsctl setup` writes this service's .env with
# generated secrets and your settings; this file just documents what's in it. (A copied example
# keeps its placeholder passwords — `hsctl secrets show` flags them.)
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis

NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=change-me-admin

# Hosts/IPs you'll reach Nextcloud on, space separated. With IP:port access this is
# just the server's LAN IP (hsctl fills it in).
NC_TRUSTED_DOMAINS=192.168.1.10
# CIDR of your reverse proxy / docker network so client IPs are read correctly. Caddy sits
# on the shared "edge" docker network (a 172.16.0.0/12 subnet), so this covers it.
NC_TRUSTED_PROXIES=172.16.0.0/12
# No host port: Nextcloud isn't published on the LAN. Caddy reaches the app as
# nextcloud-app:80 over the "edge" network and serves it over HTTPS.
